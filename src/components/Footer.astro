---
import SolanaMark from './SolanaMark.astro';

const cols = [
  {
    title: 'Browse',
    links: [
      { href: '/skills', label: 'Official skills' },
      { href: '/ecosystem', label: 'Ecosystem' },
      { href: '/api/skills.json', label: 'JSON index' },
      { href: '/llms.txt', label: 'llms.txt' },
    ],
  },
  {
    title: 'Foundation',
    links: [
      { href: 'https://github.com/solana-foundation', label: 'GitHub' },
      { href: 'https://github.com/solana-foundation/awesome-solana-ai', label: 'Awesome Solana AI' },
      { href: 'https://solana.com/developers', label: 'Developers' },
      { href: 'https://solana.com/docs', label: 'Docs' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: 'https://agentskills.io', label: 'Agent Skills spec' },
      { href: 'https://code.claude.com/docs/en/skills', label: 'Skills in Claude Code' },
      { href: 'https://solana.com/ai', label: 'Solana × AI' },
      { href: 'https://solana.stackexchange.com', label: 'Stack Exchange' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand" aria-label="Solana Skills home">
          <SolanaMark size={26} />
          <span>Solana <span class="thin">Skills</span></span>
        </a>
        <p>
          Agent skills for building on Solana — curated, hosted, and ready for Claude Code, Cursor,
          Codex, and any agent that reads markdown.
        </p>
      </div>
      {
        cols.map((col) => (
          <div class="footer-col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener' : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Solana Foundation</span>
      <span class="foot-sep" aria-hidden="true">·</span>
      <span>Skill content belongs to its authors under their repository licenses.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 64px 0 40px;
    margin-top: 40px;
    background: linear-gradient(180deg, transparent, rgba(153, 69, 255, 0.045));
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-weight: 660;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .thin {
    font-weight: 420;
    color: var(--text-2);
  }
  .footer-brand p {
    margin-top: 16px;
    color: var(--text-3);
    font-size: 0.9rem;
    max-width: 34ch;
  }
  .footer-col h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    font-weight: 600;
    margin-bottom: 16px;
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-col a {
    color: var(--text-2);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .footer-col a:hover {
    color: var(--green);
  }
  .footer-bottom {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: 0.82rem;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
