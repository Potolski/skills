---
import Base from '../layouts/Base.astro';
import RepoCard from '../components/RepoCard.astro';
import { registry } from '../lib/registry';

const groups: { title: string; sub: string; types: string[] }[] = [
  {
    title: 'Aggregators & toolkits',
    sub: 'Many skills per repo — protocol collections and full agent workspaces.',
    types: ['aggregator', 'toolkit'],
  },
  {
    title: 'Teams & protocols',
    sub: 'Skills maintained by the teams behind the protocols and infra they cover.',
    types: ['vendor'],
  },
  {
    title: 'Community',
    sub: 'Independent builders — smaller scope, newer, less battle-tested.',
    types: ['community'],
  },
];

const byTypes = (types: string[]) => registry.ecosystem.filter((r) => types.includes(r.type));
const skillSum = registry.ecosystem.reduce((n, r) => n + r.skills.length, 0);
---

<Base
  title="Ecosystem — Solana Skills"
  description={`Explore ${registry.ecosystem.length} Solana ecosystem skill repositories — ${skillSum} indexed skills from Jupiter, Helius, Metaplex, SendAI, Solana Mobile, Trail of Bits, and more.`}
  ogImage="/og/ecosystem.png"
>
  <section class="section eco-head">
    <div class="container">
      <h1 class="section-title">Ecosystem skill repositories</h1>
      <p class="section-sub">
        Beyond the official skills: {skillSum} skills indexed across {registry.ecosystem.length}
        repositories from Solana teams and the community. Sourced from
        <a
          class="inline-link"
          href="https://github.com/solana-foundation/awesome-solana-ai"
          target="_blank"
          rel="noopener">awesome-solana-ai</a
        > and direct ecosystem research, refreshed weekly from GitHub.
      </p>
    </div>
  </section>

  <section class="eco-group">
    <div class="container">
      <h2 class="group-title">More from the Foundation</h2>
      <p class="group-sub muted">
        The docs MCP server, the source directory, and the agentic-payments registry.
      </p>
      <div class="grid resources">
        {
          registry.foundationResources.map((res) => (
            <a class="card" href={res.url} target="_blank" rel="noopener">
              <svg
                class="card-arrow"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
              <div class="res-head">
                <img
                  class="res-logo"
                  src={`/logos/${res.repo.split('/')[0]}.png`}
                  alt=""
                  width="20"
                  height="20"
                  loading="lazy"
                />
                <span class="badge badge-official">Official</span>
                <span class="badge">{res.kind}</span>
              </div>
              <h3>{res.name}</h3>
              <code class="mono res-repo">{res.repo}</code>
              <p>{res.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    groups.map((group) => {
      const repos = byTypes(group.types);
      return (
        repos.length > 0 && (
          <section class="eco-group">
            <div class="container">
              <h2 class="group-title">{group.title}</h2>
              <p class="group-sub muted">{group.sub}</p>
              <div class="grid">
                {repos.map((repo) => (
                  <RepoCard repo={repo} />
                ))}
              </div>
            </div>
          </section>
        )
      );
    })
  }

  <section class="eco-group">
    <div class="container">
      <h2 class="group-title">More community skills</h2>
      <p class="group-sub muted">
        Smaller and newer entries from
        <a
          class="inline-link"
          href="https://github.com/solana-foundation/awesome-solana-ai"
          target="_blank"
          rel="noopener">awesome-solana-ai</a
        > — repo links only; we haven&rsquo;t crawled these for individual skills.
      </p>
      <ul class="tail-list">
        {
          registry.communityIndex.map((entry) => (
            <li>
              <a href={`https://github.com/${entry.repo}`} target="_blank" rel="noopener">
                {entry.logo && (
                  <img class="tail-logo" src={entry.logo} alt="" width="18" height="18" loading="lazy" />
                )}
                <span class="tail-name">{entry.name}</span>
                <code class="mono tail-repo">{entry.repo}</code>
                <span class="tail-desc muted">{entry.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="disclaimer muted">
        <p>
          <strong>Listing criteria.</strong> Repositories come from the Foundation&rsquo;s
          <a
            class="inline-link"
            href="https://github.com/solana-foundation/awesome-solana-ai"
            target="_blank"
            rel="noopener">awesome-solana-ai</a
          > directory and from direct ecosystem research (official protocol orgs, skill registries).
          Every listed repo must contain a <code class="mono">SKILL.md</code> with
          <code class="mono">name</code> frontmatter and is re-indexed weekly. Entries whose
          upstream disappears get delisted. No security review is performed. Skills are mirrored on
          this domain only when the upstream repo declares a license; unlicensed repos are linked,
          never republished.
        </p>
        <p>
          <strong>Trust the pins, verify the installs.</strong> Ecosystem skills are independently
          developed — evaluate code, license, and security practices before use. Every skill is
          tied to an immutable commit: links point at the exact sha we indexed, mirrors carry a
          published <code class="mono">sha256</code> you can check with
          <code class="mono">curl | shasum -a 256</code>, and both are exposed per skill in
          <a class="inline-link" href="/api/skills.json">skills.json</a> alongside the commit
          timestamp. Install commands like <code class="mono">npx skills add</code> pull the
          repo&rsquo;s current HEAD — diff against the pin if that matters to you.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card add-repo">
        <div>
          <h2>Maintain a Solana skill repo?</h2>
          <p class="muted">
            Open a PR to the Foundation&rsquo;s <code class="mono">awesome-solana-ai</code> — merged
            repos are picked up by the next weekly refresh and listed here.
          </p>
        </div>
        <a
          class="btn btn-primary"
          href="https://github.com/solana-foundation/awesome-solana-ai"
          target="_blank"
          rel="noopener">Open a PR</a
        >
      </div>
    </div>
  </section>
</Base>

<style>
  .eco-head {
    padding-bottom: 24px;
    background:
      radial-gradient(50% 90% at 85% 0%, rgba(20, 241, 149, 0.08), transparent 60%),
      radial-gradient(40% 80% at 10% 0%, rgba(153, 69, 255, 0.12), transparent 60%),
      var(--bg);
  }
  .inline-link {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(20, 241, 149, 0.4);
  }
  .eco-group {
    padding-block: 28px;
  }
  .res-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .res-logo {
    border-radius: 5px;
    object-fit: cover;
    background: var(--bg-elev);
  }
  .res-repo {
    font-size: 0.76rem;
    color: var(--text-3);
  }
  .resources .card p {
    -webkit-line-clamp: 4;
  }
  .tail-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
    gap: 4px 24px;
  }
  .tail-list li a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    transition: background 0.12s ease;
    min-width: 0;
  }
  .tail-logo {
    border-radius: 5px;
    object-fit: cover;
    background: var(--bg-elev);
    align-self: center;
    flex-shrink: 0;
  }
  .tail-list li a:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .tail-name {
    font-weight: 570;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .tail-repo {
    font-size: 0.74rem;
    color: var(--text-3);
    white-space: nowrap;
  }
  .tail-desc {
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tail-list li a:hover .tail-name {
    color: var(--green);
  }
  .disclaimer {
    margin-top: 28px;
    font-size: 0.8rem;
    line-height: 1.6;
    max-width: 88ch;
    padding: 14px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .disclaimer strong {
    color: var(--text-2);
  }
  @media (max-width: 560px) {
    .tail-list {
      grid-template-columns: 1fr;
    }
    .tail-list li a {
      flex-wrap: wrap;
      gap: 4px 10px;
    }
  }
  .group-title {
    font-size: 1.25rem;
  }
  .group-sub {
    margin: 6px 0 22px;
    font-size: 0.92rem;
  }
  .add-repo {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 36px;
  }
  .add-repo h2 {
    font-size: 1.3rem;
    margin-bottom: 8px;
  }
  .add-repo p {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  @media (max-width: 720px) {
    .add-repo {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
