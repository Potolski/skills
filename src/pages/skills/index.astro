---
import Base from '../../layouts/Base.astro';
import SkillCard from '../../components/SkillCard.astro';
import { registry, totalSkills, CATEGORY_LABELS } from '../../lib/registry';

const official = registry.official;
const ecoSkills = registry.ecosystem.flatMap((repo) =>
  repo.skills.map((s) => ({ ...s, vendor: repo.vendor, repoName: repo.displayName, repoId: repo.id }))
);

const categories = [
  'development',
  'defi',
  'infra-data',
  'nft-tokens',
  'wallets-mobile',
  'security',
  'research',
  'gaming',
  'migration',
];
const usedCategories = new Set([
  ...official.map((s) => s.category),
  ...ecoSkills.map((s) => s.category),
]);
---

<Base
  title="Browse skills — Solana Skills"
  description={`Search ${totalSkills()}+ agent skills for Solana: official Solana Foundation skills plus ecosystem skills from Jupiter, Helius, Metaplex, SendAI, and more.`}
>
  <section class="section catalog-head">
    <div class="container">
      <h1 class="section-title">Browse skills</h1>
      <p class="section-sub">
        Official Solana Foundation skills, plus everything indexed from ecosystem repositories.
        Ecosystem entries link to their source on GitHub.
      </p>
      <div class="filter-bar" role="search">
        <div class="search-wrap">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            id="skill-search"
            class="search-input"
            type="search"
            placeholder={`Search skills — try "jupiter", "anchor", "security"…`}
            autocomplete="off"
          />
        </div>
        <span class="result-count muted" id="result-count" aria-live="polite"></span>
      </div>
      <div class="chips" id="category-chips">
        <button class="chip" data-cat="all" aria-pressed="true">All</button>
        <button class="chip" data-cat="official" aria-pressed="false">Official</button>
        {
          categories
            .filter((c) => usedCategories.has(c))
            .map((c) => (
              <button class="chip" data-cat={c} aria-pressed="false">
                {CATEGORY_LABELS[c]}
              </button>
            ))
        }
      </div>
    </div>
  </section>

  <section class="catalog-body">
    <div class="container">
      <div class="group" id="group-official">
        <h2 class="group-title">
          <span class="badge badge-official">Official</span> Solana Foundation
        </h2>
        <div class="grid grid-official">
          {
            official.map((skill) => (
              <div
                class="filterable"
                data-name={skill.name}
                data-text={`${skill.title} ${skill.name} ${skill.description} solana foundation official`.toLowerCase()}
                data-cat={skill.category}
                data-official="true"
              >
                <SkillCard skill={skill} featured />
              </div>
            ))
          }
        </div>
      </div>

      <div class="group" id="group-eco">
        <h2 class="group-title"><span class="badge">Ecosystem</span> Indexed from the community</h2>
        <div class="grid">
          {
            ecoSkills.map((s) => (
              <div
                class="filterable"
                data-name={s.name}
                data-text={`${s.name} ${s.description} ${s.vendor} ${s.repoName}`.toLowerCase()}
                data-cat={s.category}
                data-official="false"
              >
                <a href={s.url} target="_blank" rel="noopener" class="card eco-card">
                  <svg
                    class="card-arrow"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7M7 7h10v10" />
                  </svg>
                  <div class="eco-top">
                    <code class="mono eco-name">{s.name}</code>
                    {s.multiFile && (
                      <span class="muted eco-files" title="Includes companion files">
                        multi-file
                      </span>
                    )}
                  </div>
                  <p>{s.description || 'No description provided.'}</p>
                  <div class="card-meta">
                    <span class="badge badge-vendor">{s.vendor}</span>
                    <span>{s.repoName}</span>
                  </div>
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <div class="empty-state" id="empty-state" hidden>
        <p>No skills match. Try a different search, or</p>
        <a class="btn btn-ghost btn-sm" href="/ecosystem">browse by repository →</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const search = document.getElementById('skill-search') as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#category-chips .chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.filterable'));
  const groups = [document.getElementById('group-official'), document.getElementById('group-eco')];
  const emptyState = document.getElementById('empty-state');
  const countEl = document.getElementById('result-count');
  let activeCat = 'all';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matchesQ = !q || (card.dataset.text ?? '').includes(q);
      const matchesCat =
        activeCat === 'all' ||
        (activeCat === 'official'
          ? card.dataset.official === 'true'
          : card.dataset.cat === activeCat);
      const show = matchesQ && matchesCat;
      card.classList.toggle('skeleton-hide', !show);
      if (show) visible++;
    }
    for (const group of groups) {
      if (!group) continue;
      const any = group.querySelector('.filterable:not(.skeleton-hide)');
      group.classList.toggle('skeleton-hide', !any);
    }
    if (emptyState) emptyState.hidden = visible > 0;
    if (countEl) countEl.textContent = `${visible} skill${visible === 1 ? '' : 's'}`;
  }

  search.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.cat ?? 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      apply();
    });
  }

  // Support /skills#security style deep links + ?q= searches
  const params = new URLSearchParams(location.search);
  const q = params.get('q');
  if (q) search.value = q;
  const hashCat = location.hash.slice(1);
  const hashChip = chips.find((c) => c.dataset.cat === hashCat);
  if (hashChip) {
    activeCat = hashCat;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === hashChip)));
  }
  apply();
</script>

<style>
  .catalog-head {
    padding-bottom: 36px;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(50% 90% at 15% 0%, rgba(153, 69, 255, 0.1), transparent 65%),
      var(--bg);
  }
  .filter-bar {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
  }
  .result-count {
    font-size: 0.86rem;
    white-space: nowrap;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .catalog-body {
    padding-block: 48px;
  }
  .group + .group {
    margin-top: 56px;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 22px;
  }
  .grid-official {
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  }
  @media (max-width: 940px) {
    .grid-official {
      grid-template-columns: 1fr;
    }
  }
  .filterable {
    display: contents;
  }
  .eco-card {
    padding: 20px;
    gap: 10px;
  }
  .eco-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eco-name {
    font-size: 0.92rem;
    font-weight: 620;
    color: var(--text);
  }
  .eco-files {
    font-size: 0.72rem;
    border: 1px dashed var(--border-strong);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .eco-card p {
    font-size: 0.86rem;
  }
  .empty-state {
    text-align: center;
    padding: 72px 0;
    color: var(--text-3);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .empty-state[hidden] {
    display: none;
  }
</style>
